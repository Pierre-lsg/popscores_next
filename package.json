		"@sveltejs/kit": "^2.53.4",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/lz-string": "^1.3.34",
		"@types/node": "^24.10.9",
		"@vite-pwa/sveltekit": "^1.1.0",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"gh-pages": "^6.3.0",
		"globals": "^16.5.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"svelte": "^5.49.0",
		"svelte-check": "^4.3.5",
		"typescript": "^5.9.3",
